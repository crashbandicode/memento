<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.memento.embedding</string>
    <key>ProgramArguments</key>
    <array>
        <string>{python}</string>
        <string>-m</string>
        <string>server.services.embedding_server</string>
        <string>--port</string>
        <string>8002</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{repo}/server</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>{logdir}/embedding_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{logdir}/embedding_stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTORCH_ENABLE_MPS_FALLBACK</key>
        <string>1</string>
        <key>PATH</key>
        <string>{path}</string>
        <key>MEMENTO_EMBEDDING_MODEL_NAME</key>
        <string>{model}</string>
        <key>MEMENTO_EMBEDDING_MODEL_REVISION</key>
        <string>{model_revision}</string>
        <key>MEMENTO_EMBEDDING_BACKEND</key>
        <string>{backend}</string>
        <key>MEMENTO_EMBEDDING_DEVICE</key>
        <string>{device}</string>
        <key>MEMENTO_EMBEDDING_QUERY_PREFIX</key>
        <string>{query_prefix}</string>
        <key>MEMENTO_EMBEDDING_DOCUMENT_PREFIX</key>
        <string>{document_prefix}</string>
        <key>MEMENTO_EMBEDDING_MAX_SEQUENCE_LENGTH</key>
        <string>{max_sequence_length}</string>
        <key>MEMENTO_EMBEDDING_CPU_THREADS</key>
        <string>{cpu_threads}</string>
        <key>MEMENTO_EMBEDDING_ONNX_PROVIDER</key>
        <string>{onnx_provider}</string>
        <key>MEMENTO_EMBEDDING_ONNX_FILE</key>
        <string>{onnx_file}</string>
        <key>MEMENTO_EMBEDDING_ARTIFACT_SHA256</key>
        <string>{artifact_sha256}</string>
    </dict>
</dict>
</plist>
