# ─────────────────────────────────────────────────────────────
# Memento — environment template
#
# Copy this file to `.env` (or let ./install.sh do it for you)
# and fill in the values you care about.
#
# Required secrets — if omitted, the installer generates random
# values on first run. Never commit these to a public repo.
# ─────────────────────────────────────────────────────────────

# Signs JWTs. Must be >= 32 chars, high entropy.
MEMENTO_SECRET_KEY=

# Token used by collectors to register themselves.
MEMENTO_COLLECTOR_TOKEN=

# Postgres superuser password (keep in sync with MEMENTO_DATABASE_URL).
POSTGRES_PASSWORD=

# Conservative PostgreSQL memory defaults used by docker-compose.yml.
# On a measured 16GB+ dedicated workstation, 1GB/8GB are reasonable overrides.
MEMENTO_POSTGRES_SHARED_BUFFERS=256MB
MEMENTO_POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
MEMENTO_POSTGRES_MAINTENANCE_WORK_MEM=256MB
MEMENTO_POSTGRES_RANDOM_PAGE_COST=1.1
MEMENTO_POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
MEMENTO_POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=1
MEMENTO_POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
MEMENTO_POSTGRES_MAX_WAL_SIZE=4GB
MEMENTO_POSTGRES_AUTOVACUUM_NAPTIME=30s
MEMENTO_POSTGRES_AUTOVACUUM_VACUUM_COST_LIMIT=2000

# Daily CSV backup compression. Level 1 minimizes workstation CPU; backups
# spill past 64 MB to disk and stream to MinIO instead of accumulating in RAM.
MEMENTO_BACKUP_GZIP_LEVEL=1

# Optional read/search database URL. Empty routes search through the primary
# without creating another pool. A configured PostgreSQL target is opened
# read-only and may be a streaming replica.
# MEMENTO_SEARCH_DATABASE_URL=postgresql+asyncpg://postgres:password@replica:5432/memento

# MinIO / S3 credentials.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Optional — AI backends for daily summaries & graph extraction
# ─────────────────────────────────────────────────────────────

# Anthropic Claude (for `/api/daily/*/generate-summary`). Leave blank to disable.
ANTHROPIC_API_KEY=

# Alternate OpenAI-compatible endpoint (Aliyun / Kimi / etc.)
# Leave blank to disable the alt backend.
MEMENTO_AI_API_KEY=
MEMENTO_AI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

# Optional read-only spend visualization. This consumes the canonical
# spend_snapshot payload; Memento never re-prices or signs into providers.
# MEMENTO_SPEND_DASHBOARD_URL=http://host.docker.internal:8080
# MEMENTO_SPEND_DASHBOARD_ACCESS_TOKEN=
# MEMENTO_SPEND_DASHBOARD_CACHE_TTL_SECONDS=300
MEMENTO_AI_MODEL=kimi-k2.5

# ─────────────────────────────────────────────────────────────
# Optional — embedding server (semantic search + MCP memory recall)
# ─────────────────────────────────────────────────────────────
#
# BGE-M3 runs on the HOST (not in Docker — needs GPU passthrough).
# The api container talks to it via this URL. Default works for both:
#   - Docker Desktop (Mac / Windows): host.docker.internal auto-resolves
#   - Linux: docker-compose.yml adds an extra_hosts entry that maps
#     host.docker.internal to the host gateway (Docker 20.10+)
#
# Override only if you run the embedding server somewhere else (a
# different machine on the LAN, a separate process, etc.):
#   MEMENTO_EMBEDDING_SERVER_URL=http://192.168.1.x:8002
MEMENTO_EMBEDDING_SERVER_URL=http://host.docker.internal:8002
MEMENTO_EMBEDDING_MODEL_NAME=BAAI/bge-m3
MEMENTO_EMBEDDING_MODEL_REVISION=
MEMENTO_EMBEDDING_BACKEND=torch
MEMENTO_EMBEDDING_DEVICE=cpu
MEMENTO_EMBEDDING_DIM=1024
MEMENTO_EMBEDDING_QUERY_PREFIX=
MEMENTO_EMBEDDING_DOCUMENT_PREFIX=
MEMENTO_EMBEDDING_MAX_SEQUENCE_LENGTH=0

# Optional ONNX/int8 CPU image. Torch remains the safe default. Int8 is
# exported at build time from the official model; enable it only after running
# the parity/latency benchmark for the target CPU and corpus.
MEMENTO_EMBEDDING_ONNX_QUANTIZE=0
MEMENTO_EMBEDDING_ONNX_QUANTIZATION_CONFIG=avx2
MEMENTO_EMBEDDING_ONNX_PROVIDER=
MEMENTO_EMBEDDING_ONNX_FILE=
MEMENTO_EMBEDDING_ARTIFACT_SHA256=

# Optional two-tier routing. Disabled preserves the existing BGE-M3-only
# corpus. When enabled, new ordinary conversation/backlog documents use the
# separate 384-d service/table; important memory categories remain BGE-M3.
# Keep disabled until the small model passes multilingual/ranking benchmarks.
MEMENTO_EMBEDDING_TIERING_ENABLED=false
MEMENTO_EMBEDDING_FAST_SERVER_URL=http://embedding-fast:8003
MEMENTO_EMBEDDING_FAST_MODEL_NAME=intfloat/multilingual-e5-small
MEMENTO_EMBEDDING_FAST_MODEL_REVISION=
MEMENTO_EMBEDDING_FAST_DIM=384
MEMENTO_EMBEDDING_FAST_BACKEND=torch
MEMENTO_EMBEDDING_FAST_DEVICE=cpu
MEMENTO_EMBEDDING_FAST_QUERY_PREFIX="query: "
MEMENTO_EMBEDDING_FAST_DOCUMENT_PREFIX="passage: "
MEMENTO_EMBEDDING_FAST_MAX_SEQUENCE_LENGTH=512
MEMENTO_EMBEDDING_FAST_CPUS=0.5
MEMENTO_EMBEDDING_FAST_CPU_THREADS=1
MEMENTO_EMBEDDING_FAST_MODEL_BATCH_SIZE=16
MEMENTO_EMBEDDING_FAST_ONNX_QUANTIZE=0
MEMENTO_EMBEDDING_FAST_ONNX_QUANTIZATION_CONFIG=avx2
MEMENTO_EMBEDDING_FAST_ONNX_PROVIDER=
MEMENTO_EMBEDDING_FAST_ONNX_FILE=
MEMENTO_EMBEDDING_FAST_ARTIFACT_SHA256=

# Docker embedding CPU guardrail. The workstation-safe defaults cap BGE-M3
# below one logical CPU without changing its 10-item model batches or 50-chunk
# jobs. Raise both values on a dedicated inference host; keep CPU_THREADS at or
# below the CPU quota to avoid PyTorch/BLAS oversubscription.
MEMENTO_EMBEDDING_CPUS=0.75
MEMENTO_EMBEDDING_CPU_THREADS=1
MEMENTO_EMBEDDING_MODEL_BATCH_SIZE=10
MEMENTO_EMBEDDING_REQUEST_TIMEOUT_SECONDS=1200

# Delay post-ingest embedding until an actively growing conversation has been
# quiet for this long. Set the byte threshold to 0 to cover every conversation;
# raise it only when running without the compose-managed Celery workers.
MEMENTO_POST_INGEST_QUIET_SECONDS=600
MEMENTO_POST_INGEST_LARGE_CONVERSATION_BYTES=0

# ─────────────────────────────────────────────────────────────
# Optional — PyPI mirror for Docker build (slow / blocked networks)
# ─────────────────────────────────────────────────────────────
#
# Default empty = use pypi.org directly. If `docker compose build` times
# out reading files.pythonhosted.org, set a faster mirror here. The api +
# celery-worker + celery-beat services all honor this build arg.
#
# Mainland China options:
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
#   PIP_INDEX_URL=https://pypi.mirrors.ustc.edu.cn/simple/
# PIP_INDEX_URL=
